# Server-side only. Never prefix this with NEXT_PUBLIC_ and never commit a real key.
# Create one at https://console.x.ai — xAI API keys start with xai-
# The same key writes the song (Grok) and speaks the vocal (POST /v1/tts).
XAI_API_KEY=

# Optional. Defaults to grok-4.7 (structured song JSON, low reasoning effort).
# XAI_MODEL=grok-4.7

# Optional. low | medium | high | xhigh. Defaults to low to save credits and latency.
# XAI_REASONING_EFFORT=low
